<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/stats_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#6608070C" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stats_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="Your viewing"
            android:textColor="#F2FFFFFF"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/stats_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#8CFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="46dp"
        android:layout_marginEnd="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/range_today"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:text="Today"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/range_week"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:text="This week"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/stats_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="112dp"
        android:layout_marginEnd="48dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="552dp"
        android:layout_height="162dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="192dp"
        android:background="@drawable/stats_panel_bg"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="15dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chart_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:textColor="#F2FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/chart_legend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#A6FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.argon.launcher.BarsView
            android:id="@+id/chart_bars"
            android:layout_width="match_parent"
            android:layout_height="95dp" />

        <LinearLayout
            android:id="@+id/chart_labels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="552dp"
        android:layout_height="148dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="368dp"
        android:background="@drawable/stats_panel_bg"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/shows_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shows and videos"
            android:textColor="#F2FFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/shows_col_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:layout_weight="1"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/shows_col_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="292dp"
        android:layout_height="324dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="192dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/stats_panel_bg"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="15dp"
        android:paddingEnd="18dp"
        android:paddingBottom="13dp">

        <TextView
            android:id="@+id/apps_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apps"
            android:textColor="#F2FFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/apps_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="App"
                android:textColor="#73FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Today"
                android:textColor="#73FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="This week"
                android:textColor="#73FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:layout_width="43dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Opens"
                android:textColor="#73FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/apps_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/apps_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="#73FFFFFF"
            android:textSize="10.5sp" />
    </LinearLayout>
</FrameLayout>
